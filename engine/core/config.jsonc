{
    "time_window": 5,
    "max_sequence": 1000000000,
    "ddos_threshold": 50000000,
    "max_queue_size": 1000000000,
    "ai_context_epochs": 5,
    "ai_anomaly_threshold": 0.85,
    "qdrant_path": "DB/vector",
    "qdrant_url": null,
    "mongo_uri": "mongodb://localhost:27017/",
    "memory_dedup_dist": 0.05,
    "memory_query_dist": 0.15,
    "ai_checkpoint_file": "auto",
    "checkpoint_interval_seconds": 3600,
    "max_checkpoints_history": 5,
    "forensic_sample_rate": 100,
    "forensic_sample_mode": "random",
    "misp_enabled": false,
    "misp_url": "https://misp.local",
    "misp_verify_ssl": true,
    "misp_cache_ttl_sec": 3600,
    "storage_policy": {
        "save_vectors": {
            "ai_safe": true,
            "anomaly": true
        },
        "save_logs": {
            "ai_safe": true,
            "anomaly": true,
            "ddos_evidence": true
        }
    },
    "alert_policy": {
        "misp_report": true,
        "console_alerts": {
            "new_anomaly": true,
            "known_threat": true,
            "false_positive": false
        }
    },
    "retention_policy": {
        "enabled": true,
        "run_interval_hours": 24,
        "keep_days": {
            "ai_safe": 7,
            "new_anomaly": 90,
            "known_threat": 365,
            "false_positive": 3,
            "misp_alert": 365,
            "ddos_evidence": 14
        }
    },
    "redis": {
        "enabled": true,
        "host": "localhost",
        "port": 6379,
        "queue": "kinetix_ingest",
        "storage_queue": "kinetix_storage",
        "batch_size": 50
    }
}