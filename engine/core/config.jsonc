{
    "port": 5001,
    "time_window": 5.0,
    "max_sequence": 100,
    "ddos_threshold": 50,
    "max_queue_size": 10000,
    "ai_context_epochs": 5,
    "ai_anomaly_threshold": 0.81,
    "qdrant_path": "DB/vector",
    "qdrant_url": null,
    "mongo_uri": "mongodb://localhost:27017/",
    "memory_dedup_dist": 0.05,
    "memory_query_dist": 0.1,
    "ai_checkpoint_file": "auto",
    "checkpoint_interval_seconds": 8215,
    "max_checkpoints_history": 8,
    "forensic_sample_rate": 58,
    "forensic_sample_mode": "sequence",
    "misp_enabled": true,
    "misp_url": "https://misp.local",
    "misp_verify_ssl": true,
    "storage_policy": {
        "save_vectors": {
            "ai_safe": true,
            "anomaly": true
        },
        "save_logs": {
            "ai_safe": true,
            "anomaly": true,
            "ddos_evidence": true
        }
    },
    "alert_policy": {
        "misp_report": true,
        "console_alerts": {
            "new_anomaly": true,
            "known_threat": true,
            "false_positive": false
        }
    },
    "retention_policy": {
        "enabled": true,
        "run_interval_hours": 24,
        "keep_days": {
            "ai_safe": 30,
            "new_anomaly": 90,
            "known_threat": 365,
            "false_positive": 7,
            "misp_alert": 365,
            "ddos_evidence": 3
        }
    }
}