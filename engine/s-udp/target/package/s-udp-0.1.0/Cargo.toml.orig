[package]
name = "s-udp"
version = "0.1.0"
edition = "2021"
description = "A high-performance, secure, streaming UDP protocol with Ed25519 sliding window handshakes."
license = "MIT OR Apache-2.0"
keywords = ["udp", "streaming", "network", "protocol", "security"]

[dependencies]
tokio = { version = "1.37", features = ["full"] }
anyhow = "1.0"
dashmap = "5.5"
rand = "0.8"
ring = "0.17"
sha2 = "0.10"
chacha20poly1305 = "0.10.1"
zeroize = { version = "1.7", features = ["derive"] }
x25519-dalek = { version = "2.0", features = ["static_secrets"] }
chrono = "0.4"
